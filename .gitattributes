# Normalise line endings inside the repository, keep platform scripts native.
* text=auto

*.sh    text eol=lf
gradlew text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binaries — never diff, never convert.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.apk  binary
*.zip  binary
